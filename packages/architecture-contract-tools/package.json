{
  "name": "@k-nex/architecture-contract-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "node dist/generate.js",
    "generated-clean": "node dist/generated-clean.js",
    "reproducibility": "node dist/reproducibility.js",
    "validate": "node dist/generate.js --check && node dist/validate-generated.js && node dist/validate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@k-nex/contracts": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.6"
  }
}
