    "@k-nex/ui-design-system-contracts": "workspace:*",
    "@k-nex/ui-forms": "workspace:*",
    "@k-nex/ui-pages": "workspace:*",
    "@k-nex/ui-runtime": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.2",
    "playwright": "1.61.0",
