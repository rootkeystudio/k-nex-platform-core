{
  "$schema": "../../../schemas/remote-ui-isolation-profile.v1.schema.json",
  "ambientNetwork": "allowed",
  "browserStorage": "host-origin",
  "channelChecks": { "authorization": true, "depth": true, "generation": true, "rate": true, "replay": true, "schema": true, "sequence": true, "size": true },
  "credentials": "include",
  "directDom": "denied",
  "hostChannel": "transferred-message-port-only",
  "hostDynamicImport": "denied",
  "popupTopNavigationDownload": "denied",
  "profile": "credentialless-remote-ui-v1",
  "realm": "same-origin-worker",
  "responsePolicy": { "contentSecurityPolicy": "default-src *", "credentialsMode": "include", "crossOriginResourcePolicy": "cross-origin", "generationPinnedIntegrity": true, "strictMime": true },
  "schemaVersion": 1,
  "serviceWorkers": "denied",
  "sharedWorkers": "denied"
}
