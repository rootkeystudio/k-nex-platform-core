{
  "$schema": "../../../schemas/hot-application-manifest.v1.schema.json",
  "actions": [{ "id": "sales.assistant-action", "path": "schemas/actions/assistant.json" }],
  "assets": ["assets/assistant-logo.svg"],
  "capabilities": [{ "kind": "records", "operations": ["query"], "reason": "Read assigned Sales tasks.", "required": true, "resources": [{ "id": "sales.tasks", "version": 1 }] }],
  "displayName": "Sales Assistant",
  "entrypoints": { "server": ["server/assistant.mjs"], "ui": ["ui/assistant.mjs"] },
  "eventSubscriptions": [{ "eventType": "sales.task-created", "logicFunctionId": "sales.assistant-handler" }],
  "healthChecks": [{ "entrypoint": "server/assistant.mjs", "id": "sales.assistant-health" }],
  "id": "app.sales-assistant",
  "deliveryClass": "hot-application",
  "localization": [{ "locale": "en", "path": "locales/en.json" }],
  "logicFunctions": [{ "entrypoint": "server/assistant.mjs", "id": "sales.assistant-handler" }],
  "navigation": [{ "id": "sales.assistant-nav", "screenId": "sales.assistant-screen", "title": "Assistant" }],
  "resourceBudget": { "maxAssetBytes": 262144, "maxBundleBytes": 1048576, "maxConcurrency": 4, "maxCpuMilliCores": 500, "maxInputBytes": 65536, "maxLogBytes": 65536, "maxMemoryMiB": 128, "maxOutputBytes": 131072, "maxStorageBytes": 1048576, "maxWallTimeMs": 5000 },
  "runtimeAbi": "1.0.0",
  "schedules": [{ "id": "sales.assistant-refresh", "intervalSeconds": 300, "logicFunctionId": "sales.assistant-handler" }],
  "schemaVersion": 1,
  "screens": [{ "entrypoint": "ui/assistant.mjs", "id": "sales.assistant-screen", "route": "/" }],
  "settings": [{ "id": "sales.assistant-settings", "path": "schemas/settings/assistant.json" }],
  "sources": [{ "id": "sales.assistant-source", "path": "schemas/sources/assistant.json" }],
  "storageSchemas": [{ "id": "sales.assistant-storage", "indexes": [{ "path": "/taskId", "unique": true }], "quotaBytes": 1048576, "schemaPath": "schemas/storage/assistant.json" }],
  "tools": [{ "id": "sales.assistant-tool", "path": "schemas/tools/assistant.json" }],
  "version": "1.0.0"
}
