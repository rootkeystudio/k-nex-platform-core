{
  "$schema": "../../../schemas/runner-isolation-profile.v1.schema.json",
  "filesystem": { "code": "read-only", "hostMounts": "none", "root": "read-only", "temporaryStorage": "bounded-tmpfs" },
  "isolation": "os-container-per-generation",
