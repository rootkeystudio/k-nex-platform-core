  "policy": { "hostNetworkAdapter": "allowlisted-proxy-only", "inboundListener": "denied", "macProfile": "sha256:258d1e7e322b0dd4d9394ddc97e356e191076a89609cd07395fe5ac9656a1814", "rawEgress": "denied", "syscallProfile": "sha256:9e1b305927408a95032982bd0c5713e372cd2a3c205febc954df62e8a0de3ef8" },
  "privileges": { "databaseCredential": "none", "dockerSocket": "none", "hostSecrets": "none", "linuxCapabilities": "dropped", "noNewPrivileges": true },
  "profile": "os-container-per-generation-v1",
  "rpc": { "schemaValidated": true, "shortLivedGenerationActorIdentity": true, "transport": "structured-host-rpc-only" },
