{
  "name": "k-nex-platform-core",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "contracts:generate": "turbo run generate",
    "contracts:generated-clean": "turbo run generated-clean",
    "contracts:validate": "turbo run validate && python3 scripts/validate_repository_contracts.py",
    "contracts:test": "turbo run test",
    "contracts:reproducibility": "turbo run reproducibility",
    "docs:validate": "python3 scripts/validate_repository_contracts.py",
    "gate:1": "node scripts/gate-1-placeholder.mjs",
    "phase:0": "pnpm contracts:generate && pnpm contracts:generated-clean && pnpm contracts:validate && pnpm contracts:test && pnpm contracts:reproducibility && pnpm docs:validate"
  },
  "devDependencies": {
    "turbo": "2.10.10",
    "typescript": "6.0.3"
  }
}
