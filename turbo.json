{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "generate": {
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "generated-clean": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "validate": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "generate"
      ],
      "outputs": []
    },
    "reproducibility": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": []
    },
    "docs:validate": {
      "outputs": []
    }
  }
}
