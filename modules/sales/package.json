  "scripts": {
    "build": "tsc -b",
    "test": "node --test tests/server.test.mjs && node scripts/check-pack.mjs",
    "test:sources": "node --test tests/server.test.mjs"
  },
  "peerDependencies": {
    "@k-nex/contracts": "0.0.0"
  },
  "devDependencies": {
    "@k-nex/contracts": "workspace:*",
    "@k-nex/runtime": "workspace:*",
    "payload": "3.88.0",
    "typescript": "6.0.3"
  }
