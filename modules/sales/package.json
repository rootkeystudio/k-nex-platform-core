{
  "name": "@k-nex/module-sales",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./manifest": "./k-nex.plugin.json",
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "k-nex.plugin.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "test": "node --test tests/*.test.mjs && vitest run tests/*.test.ts && node scripts/check-boundaries.mjs && node scripts/check-pack.mjs",
    "test:mcp": "vitest run tests/mcp-sales-proof.test.ts",
    "test:sources": "node --test tests/server.test.mjs"
  },
  "peerDependencies": {
    "@k-nex/contracts": "0.0.0",
    "@k-nex/payload-adapter": "0.0.0",
    "@k-nex/runtime": "0.0.0",
    "@k-nex/ui-runtime": "0.0.0"
  },
  "devDependencies": {
    "@k-nex/builder-puck": "workspace:*",
    "@k-nex/contracts": "workspace:*",
    "@k-nex/payload-adapter": "workspace:*",
    "@k-nex/runtime": "workspace:*",
    "@k-nex/ui-runtime": "workspace:*",
    "payload": "3.88.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
