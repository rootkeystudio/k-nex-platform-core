{
  "name": "@k-nex/module-sales",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./manifest": "./k-nex.plugin.json",
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    },
    "./payload-baseline-up.sql": "./assets/payload-baseline-up.sql",
    "./payload-baseline-down.sql": "./assets/payload-baseline-down.sql",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "assets/*.sql",
    "k-nex.plugin.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "test": "node --test tests/browser.test.mjs tests/server.test.mjs tests/settings.test.mjs tests/ui.test.mjs && vitest run tests/*.test.ts tests/*.test.tsx && node scripts/check-boundaries.mjs && node scripts/check-pack.mjs",
    "test:mcp": "vitest run tests/mcp-sales-proof.test.ts",
    "test:sources": "node --test tests/server.test.mjs"
  },
  "peerDependencies": {
    "@k-nex/contracts": "1.0.0",
    "@k-nex/payload-adapter": "1.0.0",
    "@k-nex/runtime": "1.0.0",
    "@k-nex/ui-runtime": "1.0.0",
    "@k-nex/ui-components": "1.0.0",
    "@k-nex/ui-builder-blocks": "1.0.0",
    "@k-nex/ui-data": "1.0.0",
    "@k-nex/ui-design-system-contracts": "1.0.0",
    "@k-nex/ui-forms": "1.0.0",
    "@k-nex/ui-pages": "1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@k-nex/ui-components": { "optional": true },
    "@k-nex/ui-builder-blocks": { "optional": true },
    "@k-nex/ui-data": { "optional": true },
    "@k-nex/ui-design-system-contracts": { "optional": true },
    "@k-nex/ui-forms": { "optional": true },
    "@k-nex/ui-pages": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@k-nex/builder-puck": "workspace:*",
    "@k-nex/contracts": "workspace:*",
    "@k-nex/payload-adapter": "workspace:*",
    "@k-nex/runtime": "workspace:*",
    "@k-nex/ui-runtime": "workspace:*",
    "@k-nex/ui-components": "workspace:*",
    "@k-nex/ui-builder-blocks": "workspace:*",
    "@k-nex/ui-data": "workspace:*",
    "@k-nex/ui-design-system-contracts": "workspace:*",
    "@k-nex/ui-forms": "workspace:*",
    "@k-nex/ui-pages": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
