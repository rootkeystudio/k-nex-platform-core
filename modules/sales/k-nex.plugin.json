{
  "apiVersion": 1,
  "id": "module.sales",
  "kind": "module",
  "displayName": "Sales",
  "version": "1.0.0",
  "package": "@k-nex/module-sales",
  "compatibility": {
    "core": ">=1.0.0 <2.0.0",
    "payload": ">=3.0.0 <4.0.0",
    "node": ">=24.0.0 <25.0.0",
    "payloadDatabaseAdapters": [
      "postgres"
    ]
  },
  "provides": [],
  "requires": [],
  "optional": [],
  "conflicts": [],
  "surfaces": [
    "workspace"
  ],
  "lifecycle": {
    "ownsPayloadSchema": true,
    "ownsPersistentData": true,
    "disable": "supported",
    "uninstall": "unsupported",
    "purge": "supported"
  },
  "contributions": {
    "schema": {
      "sales.tasks.collection": "required"
    },
    "permissions": {
      "sales.settings.read": "required",
      "sales.settings.write": "required",
      "sales.tasks.private-note.read": "required",
      "sales.tasks.read": "required",
      "sales.tasks.revenue.read": "required",
      "sales.tasks.status.read": "required",
      "sales.tasks.title.read": "required",
      "sales.tasks.write": "required"
    },
    "settings": {
      "sales.settings.workspace": "required"
    },
    "sources": {
      "sales.tasks": "required",
      "sales.total-potential-revenue": "required"
    },
    "actions": {
      "sales.task.create": "required"
    },
    "tools": {
      "sales.tools.create-task": "required",
      "sales.tools.search-tasks": "required"
    },
    "routes": {
      "sales.route.task-detail": "required",
      "sales.route.tasks": "required"
    },
    "navigation": {
      "sales.navigation.tasks": "required"
    }
  }
}
