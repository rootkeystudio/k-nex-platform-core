{
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "const": 1,
      "type": "number"
    },
    "__schema10": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "options": {
            "$ref": "#/$defs/__schema9"
          },
          "package": {
            "type": "string"
          },
          "plugin": {
            "$ref": "#/$defs/__schema7"
          },
          "version": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "required": [
          "plugin",
          "package",
          "version"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$",
        "type": "string"
      },
      "type": "object"
    },
    "__schema11": {
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        },
        "plugin": {
          "const": "builder.puck",
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/__schema9"
        },
        "version": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "plugin",
        "package",
        "version",
        "profiles"
      ],
      "type": "object"
    },
    "__schema12": {
      "additionalProperties": {},
      "properties": {
        "database": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "docker-postgres",
                  "type": "string"
                },
                "serviceName": {
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "serviceName"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "external",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "database"
      ],
      "type": "object"
    },
    "__schema13": {
      "additionalProperties": false,
      "properties": {
        "commitGeneratedRegistries": {
          "const": true,
          "type": "boolean"
        },
        "dockerfile": {
          "type": "boolean"
        },
        "validateGeneratedFilesInCI": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "dockerfile",
        "commitGeneratedRegistries",
        "validateGeneratedFilesInCI"
      ],
      "type": "object"
    },
    "__schema14": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "items": {
            "$ref": "#/$defs/__schema15"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "required"
      ],
      "type": "object"
    },
    "__schema15": {
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "type": "string"
    },
    "__schema2": {
      "additionalProperties": false,
      "properties": {
        "defaultLocale": {
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "locales": {
          "items": {
            "$ref": "#/$defs/__schema3"
          },
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "customer-platform",
            "website-only",
            "backend-only"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "type": "object"
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "additionalProperties": false,
      "properties": {
        "deploymentMode": {
          "enum": [
            "container",
            "platform-native"
          ],
          "type": "string"
        },
        "node": {
          "const": "24.19.0",
          "type": "string"
        },
        "packageManager": {
          "const": "pnpm",
          "type": "string"
        },
        "packageManagerVersion": {
          "const": "11.9.0",
          "type": "string"
        }
      },
      "required": [
        "node",
        "packageManager",
        "packageManagerVersion",
        "deploymentMode"
      ],
      "type": "object"
    },
    "__schema5": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": false,
          "properties": {
            "database": {
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "const": "postgres",
                  "type": "string"
                },
                "connectionEnvironmentVariable": {
                  "const": "DATABASE_URL",
                  "type": "string"
                },
                "package": {
                  "const": "@payloadcms/db-postgres",
                  "type": "string"
                }
              },
              "required": [
                "adapter",
                "package",
                "connectionEnvironmentVariable"
              ],
              "type": "object"
            }
          },
          "required": [
            "database"
          ],
          "type": "object"
        }
      },
      "required": [
        "payload"
      ],
      "type": "object"
    },
    "__schema6": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/__schema7"
          },
          "options": {
            "$ref": "#/$defs/__schema9"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "required": [
          "id",
          "package",
          "version",
          "enabled"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "__schema7": {
      "pattern": "^(module|provider|builder|theme|integration|preset)(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$",
      "type": "string"
    },
    "__schema8": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "__schema9": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
    }
  },
  "$id": "https://schemas.k-nex.dev/application/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "#/$defs/__schema0"
    },
    "application": {
      "$ref": "#/$defs/__schema2"
    },
    "build": {
      "$ref": "#/$defs/__schema13"
    },
    "builder": {
      "$ref": "#/$defs/__schema11"
    },
    "development": {
      "$ref": "#/$defs/__schema12"
    },
    "environment": {
      "$ref": "#/$defs/__schema14"
    },
    "framework": {
      "$ref": "#/$defs/__schema5"
    },
    "plugins": {
      "$ref": "#/$defs/__schema6"
    },
    "providers": {
      "$ref": "#/$defs/__schema10"
    },
    "runtime": {
