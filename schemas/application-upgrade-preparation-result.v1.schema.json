{
  "$defs": {
    "__schema0": {
      "const": 1,
      "type": "number"
    },
    "__schema1": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema2": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.k-nex.dev/application-upgrade-preparation-result/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "kNexApplicationUpgradeInvariant": "preparation",
  "properties": {
    "planDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "preparedReleaseLockDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "preparedSourceCommit": {
      "$ref": "#/$defs/__schema2"
    },
    "resultDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schemaVersion",
    "planDigest",
    "preparedSourceCommit",
    "preparedReleaseLockDigest",
    "resultDigest"
  ],
  "title": "K-Nex Application Upgrade Preparation Result v1",
  "type": "object"
}
