    },
    "package": {
      "$ref": "#/$defs/__schema6"
    },
    "provides": {
      "$ref": "#/$defs/__schema9"
    },
    "requires": {
      "$ref": "#/$defs/__schema11"
    },
    "surfaces": {
      "$ref": "#/$defs/__schema16"
    },
    "version": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "apiVersion",
    "id",
    "kind",
    "displayName",
    "version",
    "package",
    "compatibility",
    "lifecycle"
  ],
  "title": "K-Nex Plugin Manifest v1",
  "type": "object"
}
